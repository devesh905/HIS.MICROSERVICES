{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "patientAuthRoute": {
        "ClusterId": "patientAuthCluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      }
    },
    "Clusters": {
      "patientAuthCluster": {
        "Destinations": {
          "d1": { "Address": "PASTE_PATIENTAUTHSERVICE_URL_HERE" }
        }
      }
    }
  }
}