{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "patientAuthRoute": {
        "ClusterId": "patientAuthCluster",
        "Match": { "Path": "/api/Auth/{**catch-all}" }
      },
      "employeeAuthRoute": {
        "ClusterId": "employeeAuthCluster",
        "Match": { "Path": "/api/EmployeeAuth/{**catch-all}" }
      },
      "ipdBillsRoute": {
        "ClusterId": "ipdCluster",
        "Match": { "Path": "/api/ipd-bills/{**catch-all}" }
      },
      "ipdRoute": {
        "ClusterId": "ipdCluster",
        "Match": { "Path": "/api/Ipd/{**catch-all}" }
      },
      "ipdPackageRoute": {
        "ClusterId": "ipdCluster",
        "Match": { "Path": "/api/IpdPackage/{**catch-all}" }
      },
      "provisionalBillRoute": {
        "ClusterId": "ipdCluster",
        "Match": { "Path": "/api/ProvisionalBill/{**catch-all}" }
      },
      "billRoute": {
        "ClusterId": "billingCluster",
        "Match": { "Path": "/api/Bill/{**catch-all}" }
      },
      "employeeBillRoute": {
        "ClusterId": "billingCluster",
        "Match": { "Path": "/api/EmployeeBill/{**catch-all}" }
      },
      "labReportRoute": {
        "ClusterId": "labReportCluster",
        "Match": { "Path": "/api/LabReport/{**catch-all}" }
      },
      "procedureReportRoute": {
        "ClusterId": "labReportCluster",
        "Match": { "Path": "/api/ProcedureReport/{**catch-all}" }
      },
      "opdMetaRoute": {
        "ClusterId": "opdRegCluster",
        "Match": { "Path": "/api/OpdMeta/{**catch-all}" }
      },
      "selfRegisterRoute": {
        "ClusterId": "opdRegCluster",
        "Match": { "Path": "/api/SelfRegister/{**catch-all}" }
      },
      "healthCampRoute": {
        "ClusterId": "healthCampCluster",
        "Match": { "Path": "/api/Healthcamp/{**catch-all}" }
      },
      "aiBillAnalysisRoute": {
        "ClusterId": "aiCluster",
        "Match": { "Path": "/api/AiBillAnalysis/{**catch-all}" }
      },
      "aiOpdTriageRoute": {
        "ClusterId": "aiCluster",
        "Match": { "Path": "/api/AiOpdTriage/{**catch-all}" }
      }
    },
    "Clusters": {
      "patientAuthCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5109" } }
      },
      "employeeAuthCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5278" } }
      },
      "ipdCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5053" } }
      },
      "billingCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5299" } }
      },
      "labReportCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5097" } }
      },
      "opdRegCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5190" } }
      },
      "healthCampCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5126" } }
      },
      "aiCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5017" } }
      }
    }
  }
}